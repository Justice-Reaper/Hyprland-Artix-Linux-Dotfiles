#!/bin/bash

blue='\033[1;34m'
reset='\033[0m'

echo -e "\n\n${blue}Hyprland Shortcuts${reset}"

echo -e "\nSuper + Return                                   →  Open terminal"
echo -e "Super + W                                        →  Close the current window"
echo -e "Super + C                                        →  Take a screenshot with Flameshot"
echo -e "Super + M                                        →  Minimize window to the vault"

echo -e "\nSuper + N                                        →  Open Nemo file manager"
echo -e "Super + A                                        →  Open PavuControl (audio settings)"
echo -e "Super + B                                        →  Open Blueman Manager (bluetooth)"
echo -e "Super + I                                        →  Open Network Connection Editor"

echo -e "\nSuper + F                                        →  Toggle floating mode on the current window"
echo -e "Super + Shift + S                                →  Toggle fullscreen mode on the current window"
echo -e "Super + L                                        →  Toggle split layout"
echo -e "Super + Shift + F                                →  Switch focus between floating and tiled windows"

echo -e "\nSuper + (↑←↓→)                                   →  Navigate between windows"
echo -e "Super + Alt + (↑←↓→)                             →  Swap windows"
echo -e "Super + Ctrl + (↑←↓→)                            →  Move floating windows"
echo -e "Super + Ctrl + Alt + (↑←↓→)                      →  Resize windows"

echo -e "\nSuper + (1,2,3,4,5,6,7,8,9,0)                    →  Switch workspace"
echo -e "Super + Shift + (1,2,3,4,5,6,7,8,9,0)            →  Move window to another workspace"
echo -e "Super + Mouse scroll                             →  Scroll through workspaces"

echo -e "\nSuper + Left click drag                          →  Move window"
echo -e "Super + Right click drag                         →  Resize window"


echo -e "\n\n${blue}Waybar Shortcuts${reset}"

echo -e "\nSuper + D                                        →  Open Rofi launcher"
echo -e "Super + P                                        →  Open Rofi power menu"
echo -e "Super + T                                        →  Open Rofi tray menu"
echo -e "Super + V                                        →  Open Rofi vault menu (minimized windows)"
echo -e "Super + S                                        →  Open Rofi scope manager"

echo -e "\nSuper + Shift + I                                →  Copy local IP address"
echo -e "Super + Shift + V                                →  Copy VPN IP address"

echo -e "\nSuper + F2                                       →  Decrease brightness"
echo -e "Super + F3                                       →  Increase brightness"

echo -e "\nSuper + F5                                       →  Mute/unmute sound"
echo -e "Super + F6                                       →  Decrease volume"
echo -e "Super + F7                                       →  Increase volume"

echo -e "\nSuper + Shift + F5                               →  Mute/unmute microphone"
echo -e "Super + Shift + F6                               →  Decrease microphone volume"
echo -e "Super + Shift + F7                               →  Increase microphone volume"

echo -e "\nSuper + F8                                       →  Toggle nightlight"
echo -e "Super + F9                                       →  Decrease nightlight temperature"
echo -e "Super + F10                                      →  Increase nightlight temperature"


echo -e "\n\n${blue}Kitty Shortcuts${reset}"

echo -e "\nCtrl + Shift + T                                →  Create tab"
echo -e "Ctrl + Shift + (↑←↓→)                           →  Navigate through tab"
echo -e "Ctrl + Shift + Alt + T                          →  Rename tab"

echo -e "\nCtrl + Shift + +                                →  Increase font size"
echo -e "Ctrl + Shift + -                                →  Decrease font size"
echo -e "Ctrl + Shift + Backspace                        →  Reset font size to default"

echo -e "\nCtrl + Shift + Enter                            →  Open subterminal"
echo -e "Ctrl + (↑←↓→)                                   →  Navigate through subterminal"
echo -e "Ctrl + Shift + R                                →  Activate resize mode on a subterminal"
echo -e "Ctrl + Shift + Z                                →  Zoom in on a subterminal"
echo -e "Kitty resize mode activated + W                 →  Increase width on a subterminal"
echo -e "Kitty resize mode activated + N                 →  Decrease width on a subterminal"
echo -e "Kitty resize mode activated + T                 →  Increase height on a subterminal"
echo -e "Kitty resize mode activated + S                 →  Decrease height on a subterminal"
echo -e "Kitty resize mode activated + Ctrl + W          →  Double the width on a subterminal"
echo -e "Kitty resize mode activated + Ctrl + N          →  Halve the width on a subterminal"
echo -e "Kitty resize mode activated + Ctrl + T          →  Double the height on a subterminal"
echo -e "Kitty resize mode activated + Ctrl + S          →  Halve the height on a subterminal"
echo -e "Kitty resize mode activated + Esc               →  Exit resize mode on a subterminal"

echo -e "\nF1                                              →  Copy content to the first clipboard"
echo -e "F2                                              →  Paste content from the first clipboard"
echo -e "F3                                              →  Copy content to the second clipboard"
echo -e "F4                                              →  Paste content from the second clipboard"


echo -e "\n\n${blue}Zsh Shortcuts${reset}"

echo -e "\nAlt + .                  →  Insert the argument from the previous command"

echo -e "\nAlt + (↑←↓→)             →  Move between word"
echo -e "Home                     →  Move to the beginning of the line"
echo -e "End                      →  Move to the end of the line"

echo -e "\nCtrl + U                 →  Delete from cursor to beginning"
echo -e "Ctrl + K                 →  Delete from cursor to end"
echo -e "Ctrl + W                 →  Delete the entire line"

echo -e "\nAlt + Del                →  Delete the word to the right of the cursor"
echo -e "Alt + Backspace          →  Delete the word to the left of the cursor"

echo -e "\nDel                      →  Delete the character to the right of the cursor"
echo -e "Backspace                →  Delete the character to the left of the cursor"

echo -e "\nPage Up                  →  Scroll up in paginate mode"
echo -e "Page Down                →  Scroll down in paginate mode"

echo -e "\nShift + Tab              →  Undo the last action"

echo -e "\nCtrl + R                 →  Use fzf to autocomplete files/directories"
echo -e "Ctrl + R                 →  Use fzf to run commands from the zsh history"

echo -e "\nEsc + Esc                →  Add sudo at the beginning of the line and if there is no text, add sudo followed by the last executed command"


echo -e "\n\n${blue}Zsh Functions${reset}"

echo -e "\nclearHistory             →  Clear the zsh history"
echo -e "removeHistory            →  Remove the zsh history"


echo -e "\n\n${blue}Rofi Launcher & Scope Shortcuts${reset}"

echo -e "\nAlt + (↑←↓→)             →  Move between word"
echo -e "Home                     →  Move to the beginning of the line"
echo -e "End                      →  Move to the end of the line"

echo -e "\nCtrl + U                 →  Delete from cursor to beginning"
echo -e "Ctrl + K                 →  Delete from cursor to end"
echo -e "Ctrl + W                 →  Delete the entire line"

echo -e "\nAlt + Del                →  Delete the word to the right of the cursor"
echo -e "Alt + Backspace          →  Delete the word to the left of the cursor"

echo -e "\nDel                      →  Delete the character to the right of the cursor"
echo -e "Backspace                →  Delete the character to the left of the cursor"

echo -e "\nEsc                      →  Exit Rofi"


echo -e "\n\n${blue}Commands${reset}"

echo -e "\nnmcli-connect-device                   →  Connects a network device (supports wifi with SSID, password and hidden networks)"
echo -e "nmcli-disconnect-device                →  Disconnects a network device"
echo -e "nmcli-create-hotspot                   →  Creates a wifi hotspot"
echo -e "nmcli-delete-connection                →  Deletes a saved connection"
echo -e "nmcli-up-connection                    →  Activates an existing connection"
echo -e "nmcli-down-connection                  →  Deactivates an active connection"
echo -e "nmcli-list-active-connections          →  Lists all active connections"
echo -e "nmcli-list-all-connections             →  Lists all saved connections"
echo -e "nmcli-list-devices                     →  Lists all network devices"
echo -e "nmcli-scan-wifi                        →  Scans for available wifi networks"
echo -e "nmcli-wifi-info                        →  Shows current wifi password and QR code"
echo -e "nmcli-wifi-on                          →  Enables wifi radio"
echo -e "nmcli-wifi-off                         →  Disables wifi radio"
echo -e "nmcli-wwan-on                          →  Enables mobile broadband radio"
echo -e "nmcli-wwan-off                         →  Disables mobile broadband radio"
echo -e "nmcli-restart-networking               →  Restarts networking"

echo -e "\nadd-asset-to-scope                     →  Adds assets to the scope"
echo -e "remove-asset-from-scope                →  Removes assets from the scope"

echo -e "\nextract-ports                          →  Extract ports from a file in nmap -oG format and copy them to the clipboard"

echo -e "\nmkt                                    →  Create a folder and several work directories inside it"

echo -e "\nxcopy                                  →  Copies file content directly to system clipboard"

echo -e "\nswitch-java-version                    →  Switches the active Java version in the environment"

echo -e "\nrollback                               →  Rolls back the system to a previous Btrfs snapshot"

echo -e "\nshow-help-panel                        →  Displays all commands and shortcuts of the desktop environment"
